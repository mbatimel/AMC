# Тег образов, который публикует .github/workflows/build.yml (совпадает с git tag, например v0.1.0)
IMAGE_TAG=0.1.0

PG_DB=amc
PG_USER=amc
PG_PASSWORD=change-me
NDS_VALUE=22

# S3-compatible storage (MinIO in the local compose stack).
S3_ACCESS_KEY=amc-minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=amc-images
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=https://wk.amctechgroup.ru/s3
S3_MAX_FILE_SIZE=10485760
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DOMAIN=wk.amctechgroup.ru
LETSENCRYPT_EMAIL=you@example.com

# SMTP для email-уведомлений admin-сервиса (подтверждение/отклонение заявок и т.п.).
# Пусто -> email-уведомление логируется как ошибка; уже сохранённое решение по
# заявке не откатывается, а новая форма «О компании» возвращает server error.
# Свой контейнер не нужен — сюда указываешь внешний relay (Яндекс.Почта, Mail.ru,
# SendGrid, AWS SES и т.п.). Для локальной разработки/теста можно поднять
# mailhog/maildev контейнер и указать его host:port сюда же.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_TIMEOUT=10s
COMPANY_REQUEST_RECIPIENT=order@voint.ru

# ИИ-помощник по подбору инструмента (DeepSeek).
# Пусто -> помощник работает на поиске по каталогу и сценарных ответах.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

API_FNS_ADDR= https://api-fns.ru/api/fl_status
API_FNS_KEY=

# 1С:УТ 10.3 — OData standard interface (сервер 46.0.206.50:4002/UT).
ONEC_BASE_URL=http://46.0.206.50:4002/UT/odata/standard.odata
ONEC_USER=
ONEC_PASSWORD=
# GUID типа цен 1С (Catalog_ТипыЦенНоменклатуры.Ref_Key), который считается
# базовой ценой сайта (product_prices.price_type='base'). У этой базы 1С
# накопилось ~60 исторических типов цен — синкается только этот один.
# Сейчас это "Цена с НДС"; сверить актуальность с 1С-бухгалтером при смене.
ONEC_BASE_PRICE_TYPE_KEY=da0b5907-dbec-11f0-ba0c-cb4b655316ff

# 1С:УТ — интеграция заказов (push/webhook).
ONEC_ORDERS_BASE_URL=http://46.0.206.50:4002/ut
ONEC_ORDERS_USER=amc
ONEC_ORDERS_PASSWORD=123890
ONEC_WEBHOOK_API_KEY=
