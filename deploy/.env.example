# Тег образов, который публикует .github/workflows/build.yml (совпадает с git tag, например v0.1.0)
IMAGE_TAG=0.1.0

PG_DB=amc
PG_USER=amc
PG_PASSWORD=change-me
NDS_VALUE=22

# S3-compatible storage (MinIO in the local compose stack).
S3_ACCESS_KEY=amc-minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=amc-images
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=https://wk.amctechgroup.ru/s3
S3_MAX_FILE_SIZE=10485760
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DOMAIN=wk.amctechgroup.ru
LETSENCRYPT_EMAIL=you@example.com

# SMTP для email-уведомлений admin-сервиса (подтверждение/отклонение заявок и т.п.).
# Пусто -> mailer молча no-op'ится, письма не уходят, ошибки нет.
# Свой контейнер не нужен — сюда указываешь внешний relay (Яндекс.Почта, Mail.ru,
# SendGrid, AWS SES и т.п.). Для локальной разработки/теста можно поднять
# mailhog/maildev контейнер и указать его host:port сюда же.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ИИ-помощник по подбору инструмента (DeepSeek).
# Пусто -> помощник работает на поиске по каталогу и сценарных ответах.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

API_FNS_ADDR= https://api-fns.ru/api/fl_status
API_FNS_KEY=ba3c7ffeda322859e6ec4031293e1f5f25748667

# 1С:УТ 10.3 (сервер PVISERVER) — OData standard interface.
# Пока не опубликован на стороне 1С (см. back/integrations/README.md) —
# воркер будет падать на каждом ране до публикации, это ожидаемо.
ONEC_BASE_URL=http://PVISERVER/UT/odata/standard.odata
ONEC_USER=
ONEC_PASSWORD=

# 1С:УТ — интеграция заказов (push/webhook).
ONEC_ORDERS_BASE_URL=
ONEC_ORDERS_USER=
ONEC_ORDERS_PASSWORD=
ONEC_WEBHOOK_API_KEY=