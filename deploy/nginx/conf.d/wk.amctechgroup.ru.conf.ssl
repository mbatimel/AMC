# Шаг 2: финальный конфиг, после того как сертификат получен.
# Переименуй в wk.amctechgroup.ru.conf (замени bootstrap-файл) и перезапусти nginx:
#   docker compose exec nginx nginx -s reload

server {
    listen 80;
    server_name wk.amctechgroup.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name wk.amctechgroup.ru;

    ssl_certificate     /etc/letsencrypt/live/wk.amctechgroup.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wk.amctechgroup.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/ {
        proxy_pass http://access:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://front:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
