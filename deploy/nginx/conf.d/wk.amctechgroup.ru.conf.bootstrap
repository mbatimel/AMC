# Шаг 1: этот конфиг используется ДО получения сертификата.
# Переименуй в wk.amctechgroup.ru.conf, получи сертификат certbot'ом,
# затем замени файлом wk.amctechgroup.ru.conf.ssl (см. README рядом).

server {
    listen 80;
    server_name wk.amctechgroup.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        proxy_pass http://access:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://front:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
