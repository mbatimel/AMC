# Базовый адрес backend-сервисов (используется и rewrite'ами Next.js, и
# серверным поиском по каталогу для ИИ-помощника)
API_PROXY_TARGET=https://wk.amctechgroup.ru

# --- ИИ-помощник по подбору инструмента (M-04) -------------------------------
# Ключ DeepSeek: https://platform.deepseek.com/api_keys
# ВАЖНО: без префикса NEXT_PUBLIC_ — переменная не должна попадать в бандл.
# Если ключ не задан, помощник работает на поиске по каталогу и сценариях.
DEEPSEEK_API_KEY=

# Модель. deepseek-chat признан устаревшим 24.07.2026.
# Актуальные: deepseek-v4-flash (быстрее/дешевле), deepseek-v4-pro (умнее).
DEEPSEEK_MODEL=deepseek-v4-flash

# Необязательные настройки
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=25000
ASSISTANT_MAX_HISTORY=8
ASSISTANT_MAX_PRODUCTS=3

# Хранилище портальных модулей без Go-сервиса (см. src/app/portal-api/README.md)
# PORTAL_DATA_FILE=/data/portal.json
